@page "/tickets/{id:int}"
@using KestrelHelpdesk.Models
@using KestrelHelpdesk.Services
@using KestrelHelpdesk.State
@inject ITicketService TicketService
@inject CurrentUserState UserState
@implements IDisposable

@rendermode InteractiveServer

<PageTitle>Ticket Details #@Id - Kestrel Helpdesk</PageTitle>

@if (ticket == null)
{
  @if (notFound)
  {
    <div class="alert alert-danger shadow-sm">
      <h4>Ticket Not Found</h4>
      <p>The ticket with ID <strong>#@Id</strong> could not be found.</p>
      <a href="/tickets" class="btn btn-outline-secondary">Back to Ticket Board</a>
    </div>
  }
  else
  {
    <p><em>Loading ticket details...</em></p>
  }
}
else
{
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>#@ticket.Id - @ticket.Title</h3>
    <div>
      <a href="/tickets/@ticket.Id/edit" class="btn btn-outline-primary btn-sm me-2">Edit Ticket</a>
      <a href="/tickets" class="btn btn-outline-secondary btn-sm">Back to Board</a>
    </div>
  </div>

  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <p class="card-text">@ticket.Description</p>
      <div class="mt-3">
        <span class="badge bg-info text-dark me-2">Status: @ticket.Status</span>
        <span class="badge bg-warning text-dark me-2">Priority: @ticket.Priority</span>
        <span class="badge bg-secondary">Category: @ticket.Category</span>
      </div>
    </div>
  </div>

  <!-- Discussion Thread / Comments -->
  <h4>Comments (@ticket.Comments.Count)</h4>
  <div class="mb-4">
    @if (!ticket.Comments.Any())
    {
      <p class="text-muted fst-italic">No comments yet. Start the conversation below!</p>
    }
    else
    {
      @foreach (var comment in ticket.Comments)
      {
        <div class="card mb-2 shadow-sm" @key="comment.Id">
          <div class="card-body py-2">
            <div class="d-flex justify-content-between">
              <strong>@comment.Author</strong>
              <span class="text-muted small">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
            </div>
            <p class="mb-0 mt-1">@comment.Text</p>
          </div>
        </div>
      }
    }
  </div>

  <!-- Add Comment Form -->
  <div class="card bg-light shadow-sm">
    <div class="card-body">
      <h5 class="card-title">Add a Comment</h5>
      <p class="small text-muted mb-2">
        Posting as: <strong>@(UserState.CurrentUser?.Name ?? "Anonymous")</strong> (@(UserState.CurrentUser?.Role ?? "Guest"))
      </p>

      <EditForm Model="newComment" OnValidSubmit="PostComment">
        <DataAnnotationsValidator />
        <div class="mb-3">
          <InputTextArea @bind-Value="newComment.Text" class="form-control" rows="3" placeholder="Write a response..." />
          <ValidationMessage For="@(() => newComment.Text)" class="text-danger small" />
        </div>
        <button type="submit" class="btn btn-primary">Post Comment</button>
      </EditForm>
    </div>
  </div>
}

@code {
  [Parameter]
  public int Id { get; set; }

  private Ticket? ticket;
  private Comment newComment = new();
  private bool notFound = false;

  protected override async Task OnInitializedAsync()
  {
    // 1. Subscribe to UserState changes so switching active users updates the UI in real time
    UserState.OnChange += HandleUserStateChanged;

    // 2. Fetch ticket data from service
    await LoadTicketAsync();
  }

  protected override async Task OnParametersSetAsync()
  {
    await LoadTicketAsync();
  }

  private async Task LoadTicketAsync()
  {
    ticket = await TicketService.GetTicketByIdAsync(Id);
    notFound = (ticket == null);
  }

  private async Task PostComment()
  {
    if (ticket != null && !string.IsNullOrWhiteSpace(newComment.Text))
    {
      // Dynamically assign author from current state container
      newComment.Author = UserState.CurrentUser?.Name ?? "Anonymous";

      await TicketService.AddCommentAsync(ticket.Id, newComment);

      // Reset input form model
      newComment = new Comment();
    }
  }

  private void HandleUserStateChanged()
  {
    // Thread-safe UI refresh when active user selection changes
    InvokeAsync(StateHasChanged);
  }

  // Always unsubscribe from state events to prevent memory leaks / lapsed listeners
  public void Dispose()
  {
    UserState.OnChange -= HandleUserStateChanged;
  }
}