@page "/tickets/{Id:int}"
@using KestrelHelpdesk.Models
@using KestrelHelpdesk.Services
@using KestrelHelpdesk.Components.UI
@using KestrelHelpdesk.State
@inject ITicketService TicketService
@inject CurrentUserState UserState
@implements IDisposable

<PageTitle>Ticket #@Id - Kestrel Helpdesk</PageTitle>

@if (notFound)
{
  <div class="alert alert-danger shadow-sm">
    <h4>Ticket Not Found</h4>
    <p>The ticket you are looking for does not exist or has been removed.</p>
    <a href="/tickets" class="btn btn-primary">Back to Board</a>
  </div>
}
else if (ticket == null)
{
  <p><em>Loading ticket details...</em></p>
}
else
{
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>#@ticket.Id - @ticket.Title</h2>
    <div>
      <a href="/tickets/@ticket.Id/edit" class="btn btn-outline-primary me-2">Edit Ticket</a>
      <a href="/tickets" class="btn btn-outline-secondary">Back to Board</a>
    </div>
  </div>

  <div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
      <p class="card-text fs-5">@ticket.Description</p>
      <div class="mt-4 d-flex gap-2">
        <StatusBadge Status="@ticket.Status" />
        <PriorityBadge Priority="@ticket.Priority" />
      </div>
    </div>
  </div>

  <h4 class="mb-3">Comments (@ticket.Comments.Count)</h4>

  @if (ticket.Comments.Any())
  {
    <div class="d-flex flex-column gap-3 mb-4">
      @foreach (var comment in ticket.Comments.OrderBy(c => c.CreatedAt))
      {
        <div class="card shadow-sm border-0" @key="comment.Id">
          <div class="card-body py-3">
            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
              <h6 class="mb-0 fw-bold">@comment.Author</h6>
              <small class="text-muted">@comment.CreatedAt.ToLocalTime().ToString("g")</small>
            </div>
            <p class="mb-0">@comment.Text</p>
          </div>
        </div>
      }
    </div>
  }

  <div class="card shadow-sm border-0 bg-light">
    <div class="card-body">
      <h5 class="card-title">Add a Comment</h5>
      <p class="text-muted small mb-2">
        Posting as: <strong>@(UserState.CurrentUser?.Name ?? "Anonymous")</strong>
      </p>
      <div class="mb-3">
        <textarea class="form-control" rows="3" placeholder="Write a response..."
                  @bind="newComment.Text" @bind:event="oninput"></textarea>
      </div>
      <button class="btn btn-primary" @onclick="PostComment"
              disabled="@string.IsNullOrWhiteSpace(newComment.Text)">
        Post Comment
      </button>
    </div>
  </div>
}

@code {
  [Parameter]
  public int Id { get; set; }

  private Ticket? ticket;
  private Comment newComment = new();
  private bool notFound = false;

  protected override async Task OnInitializedAsync()
  {
    // Subscribe to UserState changes so switching active users updates the UI in real time
    UserState.OnChange += HandleUserStateChanged;
    await LoadTicketAsync();
  }

  protected override async Task OnParametersSetAsync()
  {
    await LoadTicketAsync();
  }

  private async Task LoadTicketAsync()
  {
    ticket = await TicketService.GetTicketByIdAsync(Id);
    notFound = (ticket == null);
  }

  private async Task PostComment()
  {
    if (ticket != null && !string.IsNullOrWhiteSpace(newComment.Text))
    {
      // Dynamically assign author from current state container
      newComment.Author = UserState.CurrentUser?.Name ?? "Anonymous";

      await TicketService.AddCommentAsync(ticket.Id, newComment);

      // Reset input form model
      newComment = new Comment();

      // REFRESH DATA: Reload the ticket from the database to instantly display the new comment
      await LoadTicketAsync();
    }
  }

  private void HandleUserStateChanged()
  {
    // Thread-safe UI refresh when active user selection changes
    InvokeAsync(StateHasChanged);
  }

  // Always unsubscribe from state events to prevent memory leaks / lapsed listeners
  public void Dispose()
  {
    UserState.OnChange -= HandleUserStateChanged;
  }
}