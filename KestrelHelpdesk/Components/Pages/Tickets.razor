@page "/tickets"
@using KestrelHelpdesk.Components.UI
@using KestrelHelpdesk.Models
@using KestrelHelpdesk.Services
@inject ITicketService TicketService
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Tickets - Kestrel Helpdesk</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Ticket Board</h3>
    <a href="/tickets/new" class="btn btn-primary">Create Ticket</a>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <select class="form-select" @bind="SelectedStatus">
            <option value="">All Statuses</option>
            <option value="Open">Open</option>
            <option value="InProgress">InProgress</option>
            <option value="Resolved">Resolved</option>
            <option value="Closed">Closed</option>
        </select>
    </div>
</div>

@if (tickets == null)
{
    <p><em>Loading tickets...</em></p>
}
else
{
    <p class="text-muted">Showing @tickets.Count tickets</p>
    <div class="row g-3">
        @foreach (var ticket in tickets)
        {
            <div class="col-md-6 col-lg-4" @key="ticket.Id">
                <TicketCard Ticket="ticket" />
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    private List<Ticket>? tickets;

    private string SelectedStatus
    {
        get => StatusQuery ?? "";
        set
        {
            var uri = string.IsNullOrEmpty(value) 
                ? "/tickets" 
                : $"/tickets?status={value}";
            Nav.NavigateTo(uri);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        tickets = await TicketService.GetTicketsAsync(StatusQuery);
    }
}