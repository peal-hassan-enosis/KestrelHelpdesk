@page "/tickets"
@using KestrelHelpdesk.Models
@using KestrelHelpdesk.Services
@using KestrelHelpdesk.Components.UI
@using Microsoft.AspNetCore.Components.QuickGrid
@inject ITicketService TicketService
@inject NavigationManager Nav

<PageTitle>Tickets - Kestrel Helpdesk</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>Ticket Board</h3>
  <a href="/tickets/new" class="btn btn-primary">Create Ticket</a>
</div>

<div class="row mb-3">
  <div class="col-md-4">
    <select class="form-select" value="@StatusQuery" @onchange="OnStatusChanged">
      <option value="">All Statuses</option>
      <option value="Open">Open</option>
      <option value="InProgress">In Progress</option>
      <option value="Resolved">Resolved</option>
    </select>
  </div>
</div>

<div class="grid-container border rounded shadow-sm bg-white p-3">
  <QuickGrid @ref="grid" ItemsProvider="@ticketProvider" Pagination="@pagination" Class="table table-hover align-middle" Theme="bootstrap">
    <PropertyColumn Property="@(t => t.Id)" Title="ID" Sortable="true" />
    <PropertyColumn Property="@(t => t.Title)" Title="Title" Sortable="true" />

    <TemplateColumn Title="Status" Sortable="true">
      <StatusBadge Status="@context.Status" />
    </TemplateColumn>

    <TemplateColumn Title="Priority" Sortable="true">
      <PriorityBadge Priority="@context.Priority" />
    </TemplateColumn>

    <PropertyColumn Property="@(t => t.CreatedAt.ToLocalTime())" Title="Created" Sortable="true" Format="g" />

    <TemplateColumn Title="Actions">
      <a href="/tickets/@context.Id" class="btn btn-sm btn-outline-primary">View</a>
    </TemplateColumn>
  </QuickGrid>
</div>

<div class="mt-3">
  <Paginator State="@pagination" />
</div>

@code {
  [SupplyParameterFromQuery(Name = "status")]
  public string? StatusQuery { get; set; }

  private PaginationState pagination = new() { ItemsPerPage = 10 };
  private GridItemsProvider<Ticket>? ticketProvider;

  private QuickGrid<Ticket>? grid;

  protected override void OnInitialized()
  {
    ticketProvider = async req => await TicketService.GetPagedTicketsAsync(req, StatusQuery);
  }

  protected override async Task OnParametersSetAsync()
  {
    if (grid != null)
    {
      await grid.RefreshDataAsync();
    }
  }

  private void OnStatusChanged(ChangeEventArgs e)
  {
    var selectedValue = e.Value?.ToString();
    var uri = string.IsNullOrEmpty(selectedValue)
        ? "/tickets"
        : $"/tickets?status={selectedValue}";

    Nav.NavigateTo(uri);
  }
}
<style>
  /* Hides QuickGrid's auto-generated filler rows by checking if the ID column is empty */
  .grid-container tbody tr:has(td:first-child:empty) {
    display: none;
  }
</style>