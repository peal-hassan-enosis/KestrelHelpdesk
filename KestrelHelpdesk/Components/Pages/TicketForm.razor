@using KestrelHelpdesk.Models

<EditForm Model="TicketModel" OnValidSubmit="HandleValidSubmit">
  <DataAnnotationsValidator />
  <ValidationSummary class="alert alert-danger" />

  <div class="mb-3">
    <label class="form-label font-weight-bold">Ticket Title</label>
    <InputText @bind-Value="TicketModel.Title" class="form-control" placeholder="Brief summary of the issue" />
    <ValidationMessage For="@(() => TicketModel.Title)" class="text-danger small" />
  </div>

  <div class="row mb-3">
    <div class="col-md-6">
      <label class="form-label font-weight-bold">Category</label>
      <InputSelect @bind-Value="TicketModel.Category" class="form-select">
        <option value="">-- Select Category --</option>
        @foreach (var cat in Enum.GetValues<TicketCategory>())
        {
          <option value="@cat">@cat</option>
        }
      </InputSelect>
      <ValidationMessage For="@(() => TicketModel.Category)" class="text-danger small" />
    </div>

    <div class="col-md-6">
      <label class="form-label font-weight-bold">Priority</label>
      <InputSelect @bind-Value="TicketModel.Priority" class="form-select">
        <option value="">-- Select Priority --</option>
        @foreach (var prio in Enum.GetValues<TicketPriority>())
        {
          <option value="@prio">@prio</option>
        }
      </InputSelect>
      <ValidationMessage For="@(() => TicketModel.Priority)" class="text-danger small" />
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label font-weight-bold">Description</label>
    <InputTextArea @bind-Value="TicketModel.Description" class="form-control" rows="5" placeholder="Detailed explanation of the issue" />
    <ValidationMessage For="@(() => TicketModel.Description)" class="text-danger small" />
  </div>

  <div class="d-flex justify-content-between">
    <a href="/tickets" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">@SubmitButtonText</button>
  </div>
</EditForm>

@code {
  [Parameter, EditorRequired]
  public Ticket TicketModel { get; set; } = null!;

  [Parameter]
  public string SubmitButtonText { get; set; } = "Save Ticket";

  [Parameter]
  public EventCallback<Ticket> OnValidSubmit { get; set; }

  private async Task HandleValidSubmit()
  {
    if (OnValidSubmit.HasDelegate)
    {
      await OnValidSubmit.InvokeAsync(TicketModel);
    }
  }
}