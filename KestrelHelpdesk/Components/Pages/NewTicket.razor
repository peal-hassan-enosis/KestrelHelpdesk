@page "/tickets/new"
@using KestrelHelpdesk.Models
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>New Ticket - Kestrel Helpdesk</PageTitle>

<div class="container mt-4" style="max-width: 800px;">
    <h2>Create New Support Ticket</h2>
    <hr />

    <TicketForm TicketModel="newTicket" SubmitButtonText="Create Ticket" OnValidSubmit="CreateTicket" />
</div>

@code {
    private Ticket newTicket = new();

    private void CreateTicket(Ticket ticket)
    {
        // TODO: Persist via ITicketService in Assignment 5
        ticket.Id = new Random().Next(100, 999);
        Nav.NavigateTo($"/tickets/{ticket.Id}");
    }
}