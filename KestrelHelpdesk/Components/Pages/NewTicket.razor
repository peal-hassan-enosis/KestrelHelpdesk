@page "/tickets/new"
@using KestrelHelpdesk.Models
@using KestrelHelpdesk.Services
@using KestrelHelpdesk.State
@inject ITicketService TicketService
@inject CurrentUserState UserState
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Create New Ticket</PageTitle>

<h3>Create Ticket</h3>

<TicketForm TicketModel="newTicket" SubmitButtonText="Create Ticket" OnValidSubmit="CreateTicket" />

@code {
  private Ticket newTicket = new();

  private async Task CreateTicket()
  {
    await TicketService.CreateTicketAsync(newTicket);
    Nav.NavigateTo($"/tickets/{newTicket.Id}");
  }
}