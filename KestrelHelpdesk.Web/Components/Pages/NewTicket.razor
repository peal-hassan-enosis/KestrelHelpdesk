@page "/tickets/new"
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Interfaces
@using KestrelHelpdesk.Core.Models
@using Microsoft.AspNetCore.Authorization
@inject ITicketService TicketService
@inject ITicketAttachmentService TicketAttachmentService
@inject NavigationManager Nav

@attribute [Authorize(Roles = AppRoles.Employee + "," + AppRoles.Agent + "," + AppRoles.Manager)]
@rendermode InteractiveServer

<PageTitle>Create New Ticket</PageTitle>

<div class="page-shell page-shell-narrow ticket-create-page">
    <header class="page-header">
        <p class="eyebrow">NEW REQUEST</p>
        <h1 class="page-title">Create a ticket</h1>
        <p class="page-subtitle">Describe the issue, choose a category and priority, and add any helpful attachments. New tickets start as Open.</p>
    </header>
    <div class="surface-card form-surface">
        <TicketForm TicketModel="newTicket" IsCreateMode="true" SubmitButtonText="Create ticket" OnValidSubmit="CreateTicket" />
    </div>
</div>

@code {
    private Ticket newTicket = new();

    private async Task CreateTicket(TicketFormSubmission submission)
    {
        await TicketService.CreateTicketAsync(submission.Ticket);
        await TicketAttachmentService.ApplyChangesAsync(
            submission.Ticket.Id,
            submission.NewFiles,
            submission.AttachmentIdsToDelete);

        Nav.NavigateTo($"/tickets/{submission.Ticket.Id}");
    }
}
