@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong - Kestrel Helpdesk</PageTitle>

<div class="page-shell state-page">
    <section class="card onboarding-card">
        <span class="empty-state-icon mx-auto" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4Z"/><path d="M12 9v4m0 3h.01"/></svg></span>
        <p class="eyebrow">UNEXPECTED ERROR</p>
        <h1>We couldn't complete that action.</h1>
        <p class="text-muted mb-4">Something went wrong while processing your request. You can return to the ticket board and try again. If the issue continues, share the request ID with your support administrator.</p>
        @if (ShowRequestId)
        {
            <p class="request-id-line"><strong>Request ID:</strong> <code>@RequestId</code></p>
        }
        <div class="page-actions justify-content-center mt-3">
            <a href="/dashboard" class="btn btn-primary">Go to dashboard</a>
            <a href="/tickets" class="btn btn-outline-secondary">Open ticket board</a>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
