@page "/tickets/{id:int}/edit"
@using KestrelHelpdesk.Core.Interfaces
@using KestrelHelpdesk.Core.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using KestrelHelpdesk.Web.Services
@inject ITicketService TicketService
@inject ITicketAttachmentService TicketAttachmentService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Edit Ticket #@Id</PageTitle>

@if (ticketToEdit == null)
{
  @if (notFound)
  {
    <div class="alert alert-danger">
      <h4>Ticket Not Found</h4>
      <p>The requested ticket (#@Id) does not exist or you don't have access to it.</p>
      <a href="/tickets" class="btn btn-outline-secondary">Back to Ticket Board</a>
    </div>
  }
  else
  {
    <p><em>Loading ticket details...</em></p>
  }
}
else
{
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Edit Ticket #@ticketToEdit.Id</h3>
    <a href="/tickets/@ticketToEdit.Id" class="btn btn-outline-secondary btn-sm">Cancel</a>
  </div>

  <TicketForm TicketModel="ticketToEdit"
              CanEditStatus="canEditStatus"
              SubmitButtonText="Update Ticket"
              ExistingAttachments="attachmentsForEdit"
              OnExistingAttachmentRemoved="MarkAttachmentForDeletion"
              OnFilesChanged="OnFilesChanged"
              OnValidSubmit="UpdateTicket" />

  @if (!string.IsNullOrWhiteSpace(errorMessage))
  {
    <div class="alert alert-danger mt-3">@errorMessage</div>
  }
}

@code {
  [Parameter] public int Id { get; set; }
  private Ticket? ticketToEdit;
  private bool notFound;
  private bool canEditStatus = true;
  private string? errorMessage;
  private List<TicketAttachment> attachmentsForEdit = new();
  private readonly List<TicketAttachment> attachmentsToDelete = new();
  private IReadOnlyList<IBrowserFile> selectedFiles = Array.Empty<IBrowserFile>();

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    canEditStatus = !authState.User.IsInRole("Manager");
    await LoadTicketAsync();
  }

  private async Task LoadTicketAsync()
  {
    var existingTicket = await TicketService.GetTicketByIdAsync(Id);
    if (existingTicket == null)
    {
      notFound = true;
      return;
    }

    ticketToEdit = new Ticket
    {
      Id = existingTicket.Id,
      Title = existingTicket.Title,
      Description = existingTicket.Description,
      Priority = existingTicket.Priority,
      Status = existingTicket.Status,
      Category = existingTicket.Category,
      CreatedBy = existingTicket.CreatedBy,
      AssignedToUserId = existingTicket.AssignedToUserId,
      CreatedAt = existingTicket.CreatedAt,
      Comments = existingTicket.Comments
    };

    attachmentsForEdit = existingTicket.Attachments.ToList();
  }

  private Task OnFilesChanged(IReadOnlyList<IBrowserFile> files)
  {
    selectedFiles = files;
    return Task.CompletedTask;
  }

  private Task MarkAttachmentForDeletion(TicketAttachment attachment)
  {
    if (attachmentsForEdit.Remove(attachment))
      attachmentsToDelete.Add(attachment);

    return Task.CompletedTask;
  }

  private async Task UpdateTicket()
  {
    if (ticketToEdit is null) return;
    errorMessage = null;

    try
    {
      await TicketService.UpdateTicketAsync(ticketToEdit);

      foreach (var attachment in attachmentsToDelete)
        await TicketAttachmentService.DeleteAttachmentAsync(ticketToEdit.Id, attachment.Id);

      await TicketAttachmentService.AddAttachmentsAsync(
        ticketToEdit.Id,
        selectedFiles,
        attachmentsForEdit.Count);

      Nav.NavigateTo($"/tickets/{ticketToEdit.Id}");
    }
    catch (Exception exception)
    {
      errorMessage = exception is InvalidOperationException or UnauthorizedAccessException or KeyNotFoundException
        ? exception.Message
        : "The ticket could not be updated. Please try again.";
    }
  }
}
