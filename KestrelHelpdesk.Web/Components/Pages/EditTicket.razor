@page "/tickets/{id:int}/edit"
@using KestrelHelpdesk.Core.Models
@using KestrelHelpdesk.Core.Interfaces
@using KestrelHelpdesk.Web.State
@inject ITicketService TicketService
@inject CurrentUserState UserState
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Edit Ticket #@Id</PageTitle>

@if (ticketToEdit == null)
{
  @if (notFound)
  {
    <div class="alert alert-danger">
      <h4>Ticket Not Found</h4>
      <p>The requested ticket (#@Id) does not exist.</p>
      <a href="/tickets" class="btn btn-outline-secondary">Back to Ticket Board</a>
    </div>
  }
  else
  {
    <p><em>Loading ticket details...</em></p>
  }
}
else
{
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Edit Ticket #@ticketToEdit.Id</h3>
    <a href="/tickets/@ticketToEdit.Id" class="btn btn-outline-secondary btn-sm">Cancel</a>
  </div>

  <!-- Reusable TicketForm Component for Editing -->
  <TicketForm TicketModel="ticketToEdit" SubmitButtonText="Update Ticket" OnValidSubmit="UpdateTicket" />
}

@code {
  [Parameter]
  public int Id { get; set; }

  private Ticket? ticketToEdit;
  private bool notFound = false;

  protected override async Task OnInitializedAsync()
  {
    var existingTicket = await TicketService.GetTicketByIdAsync(Id);

    if (existingTicket == null)
    {
      notFound = true;
    }
    else
    {
      // Clone or copy to avoid modifying live service state before form submission
      ticketToEdit = new Ticket
      {
        Id = existingTicket.Id,
        Title = existingTicket.Title,
        Description = existingTicket.Description,
        Priority = existingTicket.Priority,
        Status = existingTicket.Status,
        Category = existingTicket.Category,
        Comments = existingTicket.Comments
      };
    }
  }

  private async Task UpdateTicket()
  {
    if (ticketToEdit != null)
    {
      await TicketService.UpdateTicketAsync(ticketToEdit);
      Nav.NavigateTo($"/tickets/{ticketToEdit.Id}");
    }
  }
}