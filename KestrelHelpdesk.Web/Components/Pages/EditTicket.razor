@page "/tickets/{id:int}/edit"
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Interfaces
@using KestrelHelpdesk.Core.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@inject ITicketService TicketService
@inject ITicketAttachmentService TicketAttachmentService
@inject ILogger<EditTicket> Logger
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = AppRoles.EmployeeAgentManager)]
@rendermode InteractiveServer

<PageTitle>Edit Ticket #@Id - Kestrel Helpdesk</PageTitle>

<div class="page-shell page-shell-narrow ticket-edit-page">

@if (ticketToEdit == null)
{
  @if (notFound)
  {
    <div class="alert alert-danger p-4">
      <h4>Ticket Not Found</h4>
      <p>The requested ticket (#@Id) does not exist or you don't have access to it.</p>
      <a href="/tickets" class="btn btn-outline-secondary">Back to Ticket Board</a>
    </div>
  }
  else
  {
    <p><em>Loading ticket details...</em></p>
  }
}
else
{
  <header class="page-header page-header-split">
    <div>
      <p class="eyebrow">REQUEST DETAILS</p>
      <h1 class="page-title">Edit ticket #@ticketToEdit.Id</h1>
      <p class="page-subtitle">Update the request details and keep its status current.</p>
    </div>
    <div class="page-actions"><a href="/tickets/@ticketToEdit.Id" class="btn btn-outline-secondary">Cancel</a></div>
  </header>

  @if (!string.IsNullOrWhiteSpace(errorMessage))
  {
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@errorMessage</MudAlert>
  }

  <div class="surface-card form-surface">
    <TicketForm TicketModel="ticketToEdit"
                CanEditStatus="canEditStatus"
                SubmitButtonText="@(isSaving ? "Saving..." : "Save changes")"
                OnValidSubmit="UpdateTicket" />
  </div>
}

</div>

@code {
  [Parameter] public int Id { get; set; }
  private Ticket? ticketToEdit;
  private bool notFound;
  private bool canEditStatus = true;
  private bool isSaving;
  private string? errorMessage;

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    canEditStatus = !authState.User.IsInRole(AppRoles.Manager);
    await LoadTicketAsync();
  }

  private async Task LoadTicketAsync()
  {
    var existingTicket = await TicketService.GetTicketByIdAsync(Id);
    if (existingTicket == null)
    {
      notFound = true;
      return;
    }

    ticketToEdit = new Ticket
    {
      Id = existingTicket.Id,
      Title = existingTicket.Title,
      Description = existingTicket.Description,
      Priority = existingTicket.Priority,
      Status = existingTicket.Status,
      Category = existingTicket.Category,
      CreatedBy = existingTicket.CreatedBy,
      AssignedToUserId = existingTicket.AssignedToUserId,
      CreatedAt = existingTicket.CreatedAt,
      Comments = existingTicket.Comments,
      Attachments = existingTicket.Attachments
    };
  }

  private async Task UpdateTicket(TicketFormSubmission submission)
  {
    if (isSaving)
      return;

    isSaving = true;
    errorMessage = null;

    try
    {
      await TicketAttachmentService.SaveTicketChangesAsync(
          submission.Ticket,
          isCreateMode: false,
          files: submission.NewFiles,
          attachmentIdsToDelete: submission.AttachmentIdsToDelete);

      Nav.NavigateTo($"/tickets/{submission.Ticket.Id}");
    }
    catch (ValidationException ex)
    {
      errorMessage = ex.Message;
    }
    catch (UnauthorizedAccessException)
    {
      errorMessage = "You are not allowed to update this ticket.";
    }
    catch (KeyNotFoundException)
    {
      errorMessage = "This ticket or one of its attachments no longer exists. Reload the page and try again.";
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to save ticket {TicketId} with its attachments.", submission.Ticket.Id);
      errorMessage = "The ticket could not be saved. No ticket or attachment changes were applied. Please try again.";
    }
    finally
    {
      isSaving = false;
    }
  }
}
