@page "/tickets/{Id:int}"
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Interfaces
@using KestrelHelpdesk.Core.Models
@using Microsoft.AspNetCore.Authorization
@inject ITicketService TicketService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Ticket #@Id - Kestrel Helpdesk</PageTitle>

@if (notFound)
{
  <div class="alert alert-danger shadow-sm">
    <h4>Ticket Not Found</h4>
    <p>The ticket you are looking for does not exist or you don't have access to it.</p>
    <a href="/tickets" class="btn btn-primary">Back to Board</a>
  </div>
}
else if (ticket == null)
{
  <p><em>Loading ticket details...</em></p>
}
else
{
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>#@ticket.Id - @ticket.Title</h2>
    <div>
      <button class="btn btn-outline-primary me-2" @onclick="CopyTicketLink">Copy Link</button>
      <a href="/tickets/@ticket.Id/edit" class="btn btn-outline-primary me-2">Edit Ticket</a>
      <a href="/tickets" class="btn btn-outline-secondary">Back to Board</a>
    </div>
  </div>

  <div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
      <p class="card-text fs-5">@ticket.Description</p>
      <div class="mt-4 d-flex gap-2 flex-wrap">
        <StatusBadge Status="@ticket.Status" />
        <PriorityBadge Priority="@ticket.Priority" />
        <span class="badge text-bg-light">Assigned To: @GetAssigneeName(ticket.AssignedToUserId)</span>
      </div>
    </div>
  </div>

  <h4 class="mb-3">Comments (@ticket.Comments.Count)</h4>
  @if (ticket.Comments.Any())
  {
    <div class="d-flex flex-column gap-3 mb-4">
      @foreach (var comment in ticket.Comments.OrderBy(c => c.CreatedAt))
      {
        <div class="card shadow-sm border-0" @key="comment.Id">
          <div class="card-body py-3">
            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
              <h6 class="mb-0 fw-bold">@comment.Author</h6>
              <small class="text-muted">@comment.CreatedAt.ToLocalTime().ToString("g")</small>
            </div>
            <p class="mb-0">@comment.Text</p>
          </div>
        </div>
      }
    </div>
  }

  <div class="card shadow-sm border-0 bg-light">
    <div class="card-body">
      <h5 class="card-title">Add a Comment</h5>
      <textarea class="form-control mb-3" rows="3" placeholder="Write a response..." @bind="newComment.Text" @bind:event="oninput"></textarea>
      <button class="btn btn-primary" @onclick="PostComment" disabled="@string.IsNullOrWhiteSpace(newComment.Text)">Post Comment</button>
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }
  private Ticket? ticket;
  private Comment newComment = new();
  private bool notFound;
  private IReadOnlyList<AssignableUser> agents = Array.Empty<AssignableUser>();

  protected override async Task OnInitializedAsync()
  {
    agents = await TicketService.GetAgentsAsync();
    await LoadTicketAsync();
  }

  protected override async Task OnParametersSetAsync()
  {
    if (ticket?.Id != Id) await LoadTicketAsync();
  }

  private async Task LoadTicketAsync()
  {
    ticket = await TicketService.GetTicketByIdAsync(Id);
    notFound = ticket is null;
  }

  private string GetAssigneeName(string? userId) =>
    string.IsNullOrWhiteSpace(userId) ? "-" : agents.FirstOrDefault(a => a.Id == userId)?.DisplayName ?? "Unknown agent";

  private async Task PostComment()
  {
    if (ticket is null || string.IsNullOrWhiteSpace(newComment.Text)) return;
    await TicketService.AddCommentAsync(ticket.Id, newComment);
    newComment = new Comment();
    await LoadTicketAsync();
  }

  private Task CopyTicketLink() => JS.InvokeVoidAsync("navigator.clipboard.writeText", NavigationManager.Uri).AsTask();
}
