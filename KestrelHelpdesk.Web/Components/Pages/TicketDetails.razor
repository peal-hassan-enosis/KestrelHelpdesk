@page "/tickets/{Id:int}"
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Constants
@using KestrelHelpdesk.Core.Events
@using KestrelHelpdesk.Core.Interfaces
@using KestrelHelpdesk.Core.Models
@using KestrelHelpdesk.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject ITicketService TicketService
@inject ITicketCommentService TicketCommentService
@inject IUserDirectory UserDirectory
@inject ITicketEventService TicketEvents
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject BrowserTimeZoneService BrowserTimeZone

@attribute [Authorize(Roles = AppRoles.All)]
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Ticket #@Id - Kestrel Helpdesk</PageTitle>

<div class="page-shell page-shell-wide ticket-details-page">

<ErrorBoundary>
  <ChildContent>
    @if (notFound)
    {
      <div class="alert alert-danger shadow-sm">
        <h4>Ticket Not Found</h4>
        <p>The ticket you are looking for does not exist or you don't have access to it.</p>
        <a href="/tickets" class="btn btn-primary">Back to Board</a>
      </div>
    }
    else if (ticket == null)
    {
      <p><em>Loading ticket details...</em></p>
    }
    else
    {
      <header class="page-header page-header-split ticket-detail-header">
        <div>
          <p class="eyebrow">TICKET DETAILS · #@ticket.Id</p>
          <h1 class="page-title">@ticket.Title</h1>
          <p class="page-subtitle">Review the request, supporting files and conversation history.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-outline-primary" @onclick="CopyTicketLink">Copy link</button>
          <a href="/tickets/@ticket.Id/edit" class="btn btn-primary">Edit ticket</a>
          <a href="/tickets" class="btn btn-outline-secondary">Back to board</a>
        </div>
      </header>

      <div class="card mb-4 shadow-sm border-0 ticket-detail-card">
        <div class="card-body">
          <div class="ticket-section-heading"><span class="eyebrow">REQUEST SUMMARY</span><h2 class="card-title">Issue description</h2></div>
          <p class="card-text fs-5 ticket-description">@ticket.Description</p>
          <div class="mt-4 d-flex gap-2 flex-wrap">
            <StatusBadge Status="@ticket.Status" />
            <PriorityBadge Priority="@ticket.Priority" />
            <span class="badge text-bg-light">Assigned To: @GetAssigneeName(ticket.AssignedToUserId)</span>
          </div>
          <small class="text-muted d-block mt-3">
            Created: @(BrowserTimeZone.IsInitialized ? BrowserTimeZone.Format(ticket.CreatedAt) : "Loading local time...")
          </small>
        </div>
      </div>

      @if (ticket.Attachments.Any())
      {
        <div class="card mb-4 shadow-sm border-0 ticket-detail-card">
          <div class="card-body">
            <div class="ticket-section-heading"><span class="eyebrow">SUPPORTING FILES</span><h2 class="card-title">Attachments <span class="section-count">@ticket.Attachments.Count</span></h2></div>
            <div class="list-group list-group-flush">
              @foreach (var attachment in ticket.Attachments)
              {
                <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                  <div>
                    <span class="fw-semibold">@attachment.OriginalFileName</span>
                    <small class="text-muted ms-2">@FormatFileSize(attachment.FileSize)</small>
                  </div>
                  <a class="btn btn-sm btn-outline-primary" href="/tickets/@ticket.Id/attachments/@attachment.Id">Download</a>
                </div>
              }
            </div>
          </div>
        </div>
      }

      <div class="ticket-section-heading comments-heading"><div><span class="eyebrow">CONVERSATION</span><h2 class="card-title">Comments <span class="section-count">@ticket.Comments.Count</span></h2></div></div>
      @if (ticket.Comments.Any())
      {
        <div class="comments-list mb-4">
          @foreach (var comment in ticket.Comments.OrderBy(c => c.CreatedAt))
          {
            <div class="card shadow-sm border-0 comment-card" @key="comment.Id">
              <div class="card-body py-3">
                <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                  <h6 class="mb-0 fw-bold">@comment.Author</h6>
                  <small class="text-muted">
                    @(BrowserTimeZone.IsInitialized ? BrowserTimeZone.Format(comment.CreatedAt) : "Loading local time...")
                  </small>
                </div>
                <p class="mb-0">@comment.Text</p>
              </div>
            </div>
          }
        </div>
      }

      <div class="card shadow-sm border-0 add-comment-card ticket-detail-card">
        <div class="card-body">
          <span class="eyebrow">NEXT STEP</span><h2 class="card-title">Add a comment</h2>
          <p class="text-muted small mb-3">Share an update or add details that help the team move this request forward.</p>
          <textarea class="form-control mb-3" rows="3" placeholder="Write a response..." @bind="newComment.Text" @bind:event="oninput"></textarea>
          <button class="btn btn-primary" @onclick="PostComment" disabled="@string.IsNullOrWhiteSpace(newComment.Text)">Post Comment</button>
        </div>
      </div>
    }
  </ChildContent>
  <ErrorContent Context="exception">
    <div class="alert alert-danger shadow-sm" role="alert">
      <h4 class="alert-heading">Something went wrong</h4>
      <p class="mb-0">We couldn't display this ticket right now. Please try again or return to the ticket board.</p>
      <hr />
      <a href="/tickets" class="btn btn-primary">Back to Board</a>
    </div>
  </ErrorContent>
</ErrorBoundary>

</div>

@code {
  [Parameter] public int Id { get; set; }
  private Ticket? ticket;
  private Comment newComment = new();
  private bool notFound;
  private IReadOnlyList<AssignableUser> agents = Array.Empty<AssignableUser>();

  protected override async Task OnInitializedAsync()
  {
    TicketEvents.TicketChanged += OnTicketChangedAsync;
    agents = await UserDirectory.GetAgentsAsync();
    await LoadTicketAsync();
  }

  protected override async Task OnParametersSetAsync()
  {
    if (ticket?.Id != Id) await LoadTicketAsync();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    await BrowserTimeZone.InitializeAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnTicketChangedAsync(TicketChangedEventArgs eventArgs)
  {
    if (eventArgs.TicketId != Id) return;
    await InvokeAsync(LoadTicketAsync);
  }

  private async Task LoadTicketAsync()
  {
    ticket = await TicketService.GetTicketByIdAsync(Id);
    notFound = ticket is null;
  }

  private string GetAssigneeName(string? userId) =>
    string.IsNullOrWhiteSpace(userId) ? "-" : agents.FirstOrDefault(a => a.Id == userId)?.DisplayName ?? AppLimits.UnknownAgent;

  private async Task PostComment()
  {
    if (ticket is null || string.IsNullOrWhiteSpace(newComment.Text)) return;
    await TicketCommentService.AddCommentAsync(ticket.Id, newComment);
    newComment = new Comment();
    await LoadTicketAsync();
  }

  private Task CopyTicketLink() => JS.InvokeVoidAsync("navigator.clipboard.writeText", NavigationManager.Uri).AsTask();

  private static string FormatFileSize(long bytes) => bytes switch
  {
    >= 1024 * 1024 => $"{bytes / 1024d / 1024d:0.##} MB",
    >= 1024 => $"{bytes / 1024d:0.##} KB",
    _ => $"{bytes} B"
  };

  public void Dispose()
  {
    TicketEvents.TicketChanged -= OnTicketChangedAsync;
  }
}
