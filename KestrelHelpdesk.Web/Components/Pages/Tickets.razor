@page "/tickets"
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Models
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Tickets - Kestrel Helpdesk</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
  <MudText Typo="Typo.h5">Ticket Board</MudText>
  <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
    <AuthorizeView Roles="Employee, Agent, Manager">
      <MudMenu Label="Export" Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@exporting">
        <MudMenuItem Label="Current page" Icon="@Icons.Material.Filled.Description" OnClick="ExportCurrentPageAsync" />
        <MudMenuItem Label="All tickets" Icon="@Icons.Material.Filled.Description" OnClick="ExportAllTicketsAsync" />
      </MudMenu>
      <MudButton Href="/tickets/new" Variant="Variant.Filled" Color="Color.Primary">Create Ticket</MudButton>
    </AuthorizeView>
  </MudStack>
</MudStack>

@if (isAgent)
{
  <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Class="mb-4">
    <MudButton Variant="@(activeScope == TicketScope.AgentAssigned ? Variant.Filled : Variant.Outlined)" OnClick="() => SetScope(TicketScope.AgentAssigned)">Assigned</MudButton>
    <MudButton Variant="@(activeScope == TicketScope.AgentCreated ? Variant.Filled : Variant.Outlined)" OnClick="() => SetScope(TicketScope.AgentCreated)">Created by Me</MudButton>
  </MudButtonGroup>
}

@if (isManager)
{
  <MudCheckBox T="bool" @bind-Value="notAssignedOnly" @bind-Value:after="RefreshGrid" Label="Not Assigned (Open only)" Class="mb-3" />
}

<MudGrid Class="mb-4">
  <MudItem xs="12" md="6">
    <MudTextField T="string" Value="@searchText" ValueChanged="OnSearchInput" Label="Search tickets" Placeholder="Title or description" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true" Variant="Variant.Outlined" />
    <MudText Typo="Typo.caption" Color="Color.Secondary">Search starts 300 ms after you stop typing.</MudText>
  </MudItem>
  <MudItem xs="12" md="4">
    <MudSelect T="string" Value="@StatusQuery" ValueChanged="OnStatusChanged" Label="Status" Variant="Variant.Outlined">
      <MudSelectItem T="string" Value="@string.Empty">All Statuses</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.Open.ToString()">Open</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.InProgress.ToString()">In Progress</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.Resolved.ToString()">Resolved</MudSelectItem>
    </MudSelect>
  </MudItem>
</MudGrid>

<MudPaper Elevation="1" Class="pa-2">
  <MudDataGrid T="Ticket" @ref="grid" ServerData="LoadGridData" RowsPerPage="15" SortMode="SortMode.Single" Hover="true" Striped="true" Dense="true" Bordered="true" LoadingProgressColor="Color.Primary">
    <Columns>
      <PropertyColumn Property="@(t => t.Id)" Title="ID" Sortable="true" />
      <PropertyColumn Property="@(t => t.Title)" Title="Title" Sortable="true" />
      <PropertyColumn Property="@(t => t.Status)" Title="Status" Sortable="true">
        <CellTemplate>
          <MudChip Size="Size.Small" Color="GetStatusColor(context.Item.Status)" Variant="Variant.Filled">@GetStatusLabel(context.Item.Status)</MudChip>
        </CellTemplate>
      </PropertyColumn>
      <PropertyColumn Property="@(t => t.Priority)" Title="Priority" Sortable="true">
        <CellTemplate>
          <MudChip Size="Size.Small" Color="GetPriorityColor(context.Item.Priority)" Variant="Variant.Filled">@context.Item.Priority</MudChip>
        </CellTemplate>
      </PropertyColumn>
      <TemplateColumn Title="Assigned To" Sortable="false">
        <CellTemplate>@GetAssigneeName(context.Item.AssignedToUserId)</CellTemplate>
      </TemplateColumn>
      <PropertyColumn Property="@(t => t.CreatedAt)" Title="Created" Sortable="true">
        <CellTemplate>@(BrowserTimeZone.IsInitialized ? BrowserTimeZone.Format(context.Item.CreatedAt) : "Loading local time...")</CellTemplate>
      </PropertyColumn>
      <TemplateColumn Title="Assignment" Sortable="false">
        <CellTemplate Context="cell">
          <AuthorizeView Roles="Manager">
            <select class="form-select form-select-sm" value="@cell.Item.AssignedToUserId" @onchange="e => ManagerAssignmentChanged(cell.Item.Id, e)">
              <option value="">Unassigned</option>
              @foreach (var agent in agents)
              {
                <option value="@agent.Id">@agent.DisplayName</option>
              }
            </select>
          </AuthorizeView>
          <AuthorizeView Roles="Agent">
            @if (activeScope == TicketScope.AgentCreated)
            {
              @if (cell.Item.AssignedToUserId == currentUserId)
              {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="() => AssignToMe(cell.Item.Id, null)">Unassign</MudButton>
              }
              else
              {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => AssignToMe(cell.Item.Id, currentUserId)">Assign to Me</MudButton>
              }
            }
          </AuthorizeView>
        </CellTemplate>
      </TemplateColumn>
      <TemplateColumn Title="Actions" Sortable="false">
        <CellTemplate>
          <MudButton Href="@($"/tickets/{context.Item.Id}")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">View</MudButton>
          <MudButton Href="@($"/tickets/{context.Item.Id}/edit")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Class="ms-1">Edit</MudButton>
        </CellTemplate>
      </TemplateColumn>
    </Columns>
    <PagerContent>
      <MudDataGridPager T="Ticket" PageSizeOptions="@(new[] { 15, 30, 50 })" />
    </PagerContent>
  </MudDataGrid>
</MudPaper>
