@page "/tickets"
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Constants
@using KestrelHelpdesk.Core.Models
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Tickets - Kestrel Helpdesk</PageTitle>

<div class="page-shell page-shell-wide tickets-page">
  <header class="page-header page-header-split">
    <div>
      <p class="eyebrow">REQUEST MANAGEMENT</p>
      <h1 class="page-title">Ticket board</h1>
      <p class="page-subtitle">Find a request, check its status and keep ownership clear.</p>
    </div>
    <div class="page-actions">
      <AuthorizeView Roles="@AppRoles.All">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@exporting" OnClick="ExportCurrentPageAsync">
          <MudIcon Icon="@Icons.Material.Filled.FileDownload" Class="me-1" />
          @(exportingCurrentPage ? "Exporting..." : "Export page")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@exporting" OnClick="ExportAllTicketsAsync">
          <MudIcon Icon="@Icons.Material.Filled.Download" Class="me-1" />
          @(exportingAllTickets ? "Exporting..." : "Export all")
        </MudButton>
        <MudButton Href="/tickets/new" Variant="Variant.Filled" Color="Color.Primary">Create ticket</MudButton>
      </AuthorizeView>
    </div>
  </header>

  @if (!string.IsNullOrWhiteSpace(assignmentErrorMessage))
  {
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIcon="@Icons.Material.Filled.Close" OnClose="@(() => assignmentErrorMessage = null)">
      @assignmentErrorMessage
    </MudAlert>
  }
  @if (!string.IsNullOrWhiteSpace(exportErrorMessage))
  {
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIcon="@Icons.Material.Filled.Close" OnClose="@(() => exportErrorMessage = null)">
      @exportErrorMessage
    </MudAlert>
  }
  @if (!string.IsNullOrWhiteSpace(exportSuccessMessage))
  {
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIcon="@Icons.Material.Filled.Close" OnClose="@(() => exportSuccessMessage = null)">
      @exportSuccessMessage
    </MudAlert>
  }

@if (isAgent)
{
  <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Class="mb-4">
    <MudButton Variant="@(activeScope == TicketScope.AgentAssigned ? Variant.Filled : Variant.Outlined)" OnClick="() => SetScope(TicketScope.AgentAssigned)">Assigned</MudButton>
    <MudButton Variant="@(activeScope == TicketScope.AgentCreated ? Variant.Filled : Variant.Outlined)" OnClick="() => SetScope(TicketScope.AgentCreated)">Created by Me</MudButton>
  </MudButtonGroup>
}

@if (isManager)
{
  <MudCheckBox T="bool" @bind-Value="notAssignedOnly" @bind-Value:after="RefreshGrid" Label="Not Assigned (Open only)" Class="mb-3" />
}

<MudGrid Class="mb-4">
  <MudItem xs="12" md="6">
    <MudTextField T="string" Value="@searchText" ValueChanged="OnSearchInput" Label="Search tickets" Placeholder="Title or description" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true" Variant="Variant.Outlined" />
    <MudText Typo="Typo.caption" Color="Color.Secondary">Search starts @AppLimits.TicketSearchDebounceMilliseconds ms after you stop typing.</MudText>
  </MudItem>
  <MudItem xs="12" md="4">
    <MudSelect T="string" Value="@StatusQuery" ValueChanged="OnStatusChanged" Label="Status" Variant="Variant.Outlined">
      <MudSelectItem T="string" Value="@string.Empty">All Statuses</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.Open.ToString()">Open</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.InProgress.ToString()">In Progress</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.Resolved.ToString()">Resolved</MudSelectItem>
    </MudSelect>
  </MudItem>
</MudGrid>

<MudPaper Elevation="1" Class="pa-2 ticket-grid-surface">
  <MudDataGrid T="Ticket" @ref="grid" ServerData="LoadGridData" RowsPerPage="@AppLimits.DefaultPageSize" SortMode="SortMode.Single" Hover="true" Striped="true" Dense="true" Bordered="true" LoadingProgressColor="Color.Primary">
    <Columns>
      <PropertyColumn Property="@(t => t.Id)" Title="ID" Sortable="true" />
      <PropertyColumn Property="@(t => t.Title)" Title="Title" Sortable="true" />
      <PropertyColumn Property="@(t => t.Status)" Title="Status" Sortable="true">
        <CellTemplate>
          <MudChip Size="Size.Small" Color="GetStatusColor(context.Item.Status)" Variant="Variant.Filled">@GetStatusLabel(context.Item.Status)</MudChip>
        </CellTemplate>
      </PropertyColumn>
      <PropertyColumn Property="@(t => t.Priority)" Title="Priority" Sortable="true">
        <CellTemplate>
          <MudChip Size="Size.Small" Color="GetPriorityColor(context.Item.Priority)" Variant="Variant.Filled">@context.Item.Priority</MudChip>
        </CellTemplate>
      </PropertyColumn>
      <TemplateColumn Title="Assigned To" Sortable="false">
        <CellTemplate>@GetAssigneeName(context.Item.AssignedToUserId)</CellTemplate>
      </TemplateColumn>
      <PropertyColumn Property="@(t => t.CreatedAt)" Title="Created" Sortable="true">
        <CellTemplate>@(BrowserTimeZone.IsInitialized ? BrowserTimeZone.Format(context.Item.CreatedAt) : "Loading local time...")</CellTemplate>
      </PropertyColumn>
      <TemplateColumn Title="Assignment" Sortable="false">
        <CellTemplate Context="cell">
          <AuthorizeView Roles="Manager">
            <select class="form-select form-select-sm" value="@cell.Item.AssignedToUserId" @onchange="e => ManagerAssignmentChanged(cell.Item.Id, e)">
              <option value="">Unassigned</option>
              @foreach (var agent in agents)
              {
                <option value="@agent.Id" disabled="@(!IsActiveAgent(agent.Id)">@(IsActiveAgent(agent.Id) ? agent.DisplayName : $"{agent.DisplayName} (Former agent)")</option>
              }
            </select>
          </AuthorizeView>
          <AuthorizeView Roles="Agent">
            @if (activeScope == TicketScope.AgentCreated)
            {
              @if (cell.Item.AssignedToUserId == currentUserId)
              {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="() => AssignToMe(cell.Item.Id, null)">Unassign</MudButton>
              }
              else
              {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => AssignToMe(cell.Item.Id, currentUserId)">Assign to Me</MudButton>
              }
            }
          </AuthorizeView>
        </CellTemplate>
      </TemplateColumn>
      <TemplateColumn Title="Actions" Sortable="false">
        <CellTemplate>
          <MudButton Href="@($"/tickets/{context.Item.Id}")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">View</MudButton>
          <MudButton Href="@($"/tickets/{context.Item.Id}/edit")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Class="ms-1">Edit</MudButton>
        </CellTemplate>
      </TemplateColumn>
    </Columns>
    <NoRecordsContent>
      <div class="empty-state ticket-empty-state">
        <span class="empty-state-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg></span>
        <h3>No tickets found</h3>
        <p>No requests match this view and filter combination. Try a different search or status, or create a new ticket.</p>
        <MudButton Href="/tickets/new" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Create ticket</MudButton>
      </div>
    </NoRecordsContent>
    <LoadingContent>
      <div class="empty-state ticket-loading-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
        <p class="mt-3">Loading tickets…</p>
      </div>
    </LoadingContent>
    <PagerContent>
      <MudDataGridPager T="Ticket" PageSizeOptions="@(new[] { AppLimits.DefaultPageSize, AppLimits.MediumPageSize, AppLimits.LargePageSize })" />
    </PagerContent>
  </MudDataGrid>
</MudPaper>
</div>
