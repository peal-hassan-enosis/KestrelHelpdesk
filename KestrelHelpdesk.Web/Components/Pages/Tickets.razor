@page "/tickets"
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Events
@using KestrelHelpdesk.Core.Interfaces
@using KestrelHelpdesk.Core.Models
@using KestrelHelpdesk.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@inject ITicketService TicketService
@inject ITicketEventService TicketEvents
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BrowserTimeZoneService BrowserTimeZone

@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Tickets - Kestrel Helpdesk</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>Ticket Board</h3>
  <AuthorizeView Roles="Employee, Agent, Manager">
    <a href="/tickets/new" class="btn btn-primary">Create Ticket</a>
  </AuthorizeView>
</div>

@if (isAgent)
{
  <div class="btn-group mb-3" role="group">
    <button class="btn @(activeScope == TicketScope.AgentAssigned ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetScope(TicketScope.AgentAssigned)">Assigned</button>
    <button class="btn @(activeScope == TicketScope.AgentCreated ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetScope(TicketScope.AgentCreated)">Created by Me</button>
  </div>
}

@if (isManager)
{
  <div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="notAssigned" @bind="notAssignedOnly" @bind:after="RefreshGrid" />
    <label class="form-check-label" for="notAssigned">Not Assigned (Open only)</label>
  </div>
}

<div class="row mb-3">
  <div class="col-md-4">
    <select class="form-select" value="@StatusQuery" @onchange="OnStatusChanged">
      <option value="">All Statuses</option>
      <option value="Open">Open</option>
      <option value="InProgress">In Progress</option>
      <option value="Resolved">Resolved</option>
    </select>
  </div>
</div>

<div class="grid-container border rounded shadow-sm bg-white p-3">
  <QuickGrid @ref="grid"
             ItemsProvider="@ticketProvider"
             Virtualize="true"
             ItemSize="48"
             OverscanCount="3"
             Class="table table-hover align-middle"
             Theme="bootstrap">
    <PropertyColumn Property="@(t => t.Id)" Title="ID" Sortable="true" />
    <PropertyColumn Property="@(t => t.Title)" Title="Title" Sortable="true" />
    <TemplateColumn Title="Status" Sortable="true" Context="ticket">
      <span class="badge @GetStatusBadgeClass(ticket.Status)">@GetStatusLabel(ticket.Status)</span>
    </TemplateColumn>
    <TemplateColumn Title="Priority" Sortable="true" Context="ticket">
      <span class="badge @GetPriorityBadgeClass(ticket.Priority)">@ticket.Priority</span>
    </TemplateColumn>
    <TemplateColumn Title="Assigned To" Context="ticket">@GetAssigneeName(ticket.AssignedToUserId)</TemplateColumn>
    <TemplateColumn Title="Created" Context="ticket">
      @(BrowserTimeZone.IsInitialized ? BrowserTimeZone.Format(ticket.CreatedAt) : "Loading local time...")
    </TemplateColumn>
    <TemplateColumn Title="Assignment" Context="ticket">
      <AuthorizeView Roles="Manager" Context="auth">
        <select class="form-select form-select-sm" value="@ticket.AssignedToUserId" @onchange="e => ManagerAssignmentChanged(ticket.Id, e)">
          <option value="">Unassigned</option>
          @foreach (var agent in agents)
          {
            <option value="@agent.Id">@agent.DisplayName</option>
          }
        </select>
      </AuthorizeView>
      <AuthorizeView Roles="Agent" Context="auth">
        @if (activeScope == TicketScope.AgentCreated)
        {
          @if (ticket.AssignedToUserId == currentUserId)
          {
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AssignToMe(ticket.Id, null)">Unassign from Me</button>
          }
          else
          {
            <button class="btn btn-sm btn-outline-primary" @onclick="() => AssignToMe(ticket.Id, currentUserId)">Assign to Me</button>
          }
        }
      </AuthorizeView>
    </TemplateColumn>
    <TemplateColumn Title="Actions" Context="ticket">
      <a href="/tickets/@ticket.Id" class="btn btn-sm btn-outline-primary">View</a>
      <a href="/tickets/@ticket.Id/edit" class="btn btn-sm btn-outline-secondary ms-1">Edit</a>
    </TemplateColumn>
  </QuickGrid>
</div>

@code {
  [SupplyParameterFromQuery(Name = "status")] public string? StatusQuery { get; set; }
  private GridItemsProvider<Ticket>? ticketProvider;
  private QuickGrid<Ticket>? grid;
  private IReadOnlyList<AssignableUser> agents = Array.Empty<AssignableUser>();
  private TicketScope activeScope = TicketScope.EmployeeOwn;
  private bool isAgent;
  private bool isManager;
  private bool notAssignedOnly;
  private string? currentUserId;

  protected override async Task OnInitializedAsync()
  {
    TicketEvents.TicketChanged += OnTicketChangedAsync;

    var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
    isAgent = user.IsInRole(AppRoles.Agent);
    isManager = user.IsInRole(AppRoles.Manager);
    currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    activeScope = isManager ? TicketScope.ManagerAll : isAgent ? TicketScope.AgentAssigned : TicketScope.EmployeeOwn;
    agents = await TicketService.GetAgentsAsync();
    ticketProvider = async req => await TicketService.GetPagedTicketsAsync(req, StatusQuery, activeScope, notAssignedOnly);
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    await BrowserTimeZone.InitializeAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnTicketChangedAsync(TicketChangedEventArgs eventArgs)
  {
    await InvokeAsync(RefreshGrid);
  }

  private async Task SetScope(TicketScope scope)
  {
    activeScope = scope;
    await RefreshGrid();
  }

  private async Task RefreshGrid()
  {
    if (grid is not null) await grid.RefreshDataAsync();
  }

  private async Task OnStatusChanged(ChangeEventArgs e)
  {
    StatusQuery = e.Value?.ToString();
    await RefreshGrid();
  }

  private async Task ManagerAssignmentChanged(int ticketId, ChangeEventArgs e)
  {
    await TicketService.AssignTicketAsync(ticketId, e.Value?.ToString());
    await RefreshGrid();
  }

  private async Task AssignToMe(int ticketId, string? agentUserId)
  {
    await TicketService.AssignTicketAsync(ticketId, agentUserId);
    await RefreshGrid();
  }

  private string GetAssigneeName(string? userId) =>
    string.IsNullOrWhiteSpace(userId) ? "-" : agents.FirstOrDefault(a => a.Id == userId)?.DisplayName ?? "Unknown agent";

  private static string GetStatusBadgeClass(TicketStatus status) => status switch
  {
    TicketStatus.Open => "bg-primary",
    TicketStatus.InProgress => "bg-warning text-dark",
    TicketStatus.Resolved => "bg-success",
    _ => "bg-secondary"
  };

  private static string GetStatusLabel(TicketStatus status) => status switch
  {
    TicketStatus.InProgress => "In Progress",
    _ => status.ToString()
  };

  private static string GetPriorityBadgeClass(TicketPriority priority) => priority switch
  {
    TicketPriority.Low => "bg-info text-dark",
    TicketPriority.Medium => "bg-secondary",
    TicketPriority.High => "bg-warning text-dark",
    TicketPriority.Critical => "bg-danger",
    _ => "bg-light text-dark"
  };

  public void Dispose()
  {
    TicketEvents.TicketChanged -= OnTicketChangedAsync;
  }
}

<style>
  .grid-container tbody tr:has(td:first-child:empty) { display: none; }
</style>
