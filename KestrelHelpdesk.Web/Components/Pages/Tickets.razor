@page "/tickets"
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Events
@using KestrelHelpdesk.Core.Interfaces
@using KestrelHelpdesk.Core.Models
@using KestrelHelpdesk.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject ITicketService TicketService
@inject ITicketEventService TicketEvents
@inject ITicketPdfService TicketPdfService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BrowserTimeZoneService BrowserTimeZone
@inject IJSRuntime JS

@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Tickets - Kestrel Helpdesk</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
  <MudText Typo="Typo.h5">Ticket Board</MudText>
  <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
    <AuthorizeView Roles="Employee, Agent, Manager">
      <MudMenu Label="Export"
               Variant="Variant.Outlined"
               Color="Color.Secondary"
               Disabled="@exporting">
        <MudMenuItem Label="Current page"
                     Icon="@Icons.Material.Filled.Description"
                     OnClick="ExportCurrentPageAsync" />
        <MudMenuItem Label="All tickets"
                     Icon="@Icons.Material.Filled.Description"
                     OnClick="ExportAllTicketsAsync" />
      </MudMenu>
      <MudButton Href="/tickets/new" Variant="Variant.Filled" Color="Color.Primary">Create Ticket</MudButton>
    </AuthorizeView>
  </MudStack>
</MudStack>

@if (isAgent)
{
  <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Class="mb-4">
    <MudButton Variant="@(activeScope == TicketScope.AgentAssigned ? Variant.Filled : Variant.Outlined)"
               OnClick="() => SetScope(TicketScope.AgentAssigned)">Assigned</MudButton>
    <MudButton Variant="@(activeScope == TicketScope.AgentCreated ? Variant.Filled : Variant.Outlined)"
               OnClick="() => SetScope(TicketScope.AgentCreated)">Created by Me</MudButton>
  </MudButtonGroup>
}

@if (isManager)
{
  <MudCheckBox T="bool" @bind-Value="notAssignedOnly" @bind-Value:after="RefreshGrid" Label="Not Assigned (Open only)" Class="mb-3" />
}

<MudGrid Class="mb-4">
  <MudItem xs="12" md="6">
    <MudTextField T="string"
                  Value="@searchText"
                  ValueChanged="OnSearchInput"
                  Label="Search tickets"
                  Placeholder="Title or description"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  Variant="Variant.Outlined" />
    <MudText Typo="Typo.caption" Color="Color.Secondary">Search starts 300 ms after you stop typing.</MudText>
  </MudItem>
  <MudItem xs="12" md="4">
    <MudSelect T="string" Value="@StatusQuery" ValueChanged="OnStatusChanged" Label="Status" Variant="Variant.Outlined">
      <MudSelectItem T="string" Value="@string.Empty">All Statuses</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.Open.ToString()">Open</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.InProgress.ToString()">In Progress</MudSelectItem>
      <MudSelectItem T="string" Value="@TicketStatus.Resolved.ToString()">Resolved</MudSelectItem>
    </MudSelect>
  </MudItem>
</MudGrid>

<MudPaper Elevation="1" Class="pa-2">
  <MudDataGrid T="Ticket"
               @ref="grid"
               ServerData="LoadGridData"
               RowsPerPage="15"
               SortMode="SortMode.Single"
               Hover="true"
               Striped="true"
               Dense="true"
               Bordered="true"
               LoadingProgressColor="Color.Primary">
    <Columns>
      <PropertyColumn Property="@(t => t.Id)" Title="ID" Sortable="true" />
      <PropertyColumn Property="@(t => t.Title)" Title="Title" Sortable="true" />
      <PropertyColumn Property="@(t => t.Status)" Title="Status" Sortable="true">
        <CellTemplate>
          <MudChip Size="Size.Small" Color="GetStatusColor(context.Item.Status)" Variant="Variant.Filled">
            @GetStatusLabel(context.Item.Status)
          </MudChip>
        </CellTemplate>
      </PropertyColumn>
      <PropertyColumn Property="@(t => t.Priority)" Title="Priority" Sortable="true">
        <CellTemplate>
          <MudChip Size="Size.Small" Color="GetPriorityColor(context.Item.Priority)" Variant="Variant.Filled">
            @context.Item.Priority
          </MudChip>
        </CellTemplate>
      </PropertyColumn>
      <TemplateColumn Title="Assigned To" Sortable="false">
        <CellTemplate>
          @GetAssigneeName(context.Item.AssignedToUserId)
        </CellTemplate>
      </TemplateColumn>
      <PropertyColumn Property="@(t => t.CreatedAt)" Title="Created" Sortable="true">
        <CellTemplate>
          @(BrowserTimeZone.IsInitialized ? BrowserTimeZone.Format(context.Item.CreatedAt) : "Loading local time...")
        </CellTemplate>
      </PropertyColumn>
      <TemplateColumn Title="Assignment" Sortable="false">
        <CellTemplate>
          <AuthorizeView Roles="Manager" Context="auth">
            <select class="form-select form-select-sm" value="@context.Item.AssignedToUserId" @onchange="e => ManagerAssignmentChanged(context.Item.Id, e)">
              <option value="">Unassigned</option>
              @foreach (var agent in agents)
              {
                <option value="@agent.Id">@agent.DisplayName</option>
              }
            </select>
          </AuthorizeView>
          <AuthorizeView Roles="Agent" Context="auth">
            @if (activeScope == TicketScope.AgentCreated)
            {
              @if (context.Item.AssignedToUserId == currentUserId)
              {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="() => AssignToMe(context.Item.Id, null)">Unassign</MudButton>
              }
              else
              {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => AssignToMe(context.Item.Id, currentUserId)">Assign to Me</MudButton>
              }
            }
          </AuthorizeView>
        </CellTemplate>
      </TemplateColumn>
      <TemplateColumn Title="Actions" Sortable="false">
        <CellTemplate>
          <MudButton Href="@($"/tickets/{context.Item.Id}")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">View</MudButton>
          <MudButton Href="@($"/tickets/{context.Item.Id}/edit")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Class="ms-1">Edit</MudButton>
        </CellTemplate>
      </TemplateColumn>
    </Columns>
    <PagerContent>
      <MudDataGridPager T="Ticket" PageSizeOptions="@(new[] { 15, 30, 50 })" />
    </PagerContent>
  </MudDataGrid>
</MudPaper>

@code {
  [SupplyParameterFromQuery(Name = "status")] public string? StatusQuery { get; set; }
  private MudDataGrid<Ticket>? grid;
  private IReadOnlyList<AssignableUser> agents = Array.Empty<AssignableUser>();
  private IReadOnlyList<Ticket> currentPageTickets = Array.Empty<Ticket>();
  private TicketScope activeScope = TicketScope.EmployeeOwn;
  private bool isAgent;
  private bool isManager;
  private bool notAssignedOnly;
  private bool exporting;
  private string? currentUserId;
  private string searchText = string.Empty;
  private string searchTerm = string.Empty;
  private string? currentSortBy;
  private bool currentSortDescending;
  private CancellationTokenSource? searchDebounceCts;
  private IJSObjectReference? pdfModule;

  protected override async Task OnInitializedAsync()
  {
    TicketEvents.TicketChanged += OnTicketChangedAsync;

    var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
    isAgent = user.IsInRole(AppRoles.Agent);
    isManager = user.IsInRole(AppRoles.Manager);
    currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    activeScope = isManager ? TicketScope.ManagerAll : isAgent ? TicketScope.AgentAssigned : TicketScope.EmployeeOwn;
    agents = await TicketService.GetAgentsAsync();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    await BrowserTimeZone.InitializeAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task<GridData<Ticket>> LoadGridData(GridState<Ticket> state, CancellationToken cancellationToken)
  {
    var sort = state.SortDefinitions.FirstOrDefault();
    currentSortBy = sort?.SortBy;
    currentSortDescending = sort?.Descending ?? false;

    var (items, totalCount) = await TicketService.GetTicketGridDataAsync(
      state.Page,
      state.PageSize,
      StatusQuery,
      searchTerm,
      activeScope,
      notAssignedOnly,
      currentSortBy,
      currentSortDescending);

    currentPageTickets = items;

    return new GridData<Ticket>
    {
      Items = items,
      TotalItems = totalCount
    };
  }

  private async Task ExportCurrentPageAsync()
  {
    await ExportTicketsAsync(currentPageTickets, "Current Page");
  }

  private async Task ExportAllTicketsAsync()
  {
    exporting = true;
    try
    {
      var tickets = await TicketService.GetTicketsForExportAsync(
        StatusQuery,
        searchTerm,
        activeScope,
        notAssignedOnly,
        currentSortBy,
        currentSortDescending);

      await ExportTicketsAsync(tickets, "All Tickets");
    }
    finally
    {
      exporting = false;
    }
  }

  private async Task ExportTicketsAsync(IReadOnlyList<Ticket> tickets, string scopeLabel)
  {
    if (tickets.Count == 0)
    {
      return;
    }

    exporting = true;
    try
    {
      var rows = tickets.Select(ticket => new TicketPdfRow(
        ticket.Id,
        ticket.Title,
        GetStatusLabel(ticket.Status),
        ticket.Priority.ToString(),
        GetAssigneeName(ticket.AssignedToUserId),
        BrowserTimeZone.IsInitialized
          ? BrowserTimeZone.Format(ticket.CreatedAt)
          : ticket.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))).ToList();

      var pdfBytes = await TicketPdfService.GenerateAsync(rows, $"Ticket Board - {scopeLabel}");
      pdfModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/pdf-export.js");

      var base64 = Convert.ToBase64String(pdfBytes);
      var fileName = $"tickets-{(scopeLabel == "Current Page" ? "current-page" : "all")}-{DateTime.Now:yyyyMMdd-HHmmss}.pdf";
      await pdfModule.InvokeVoidAsync("downloadPdf", fileName, base64);
    }
    finally
    {
      exporting = false;
    }
  }

  private async Task OnTicketChangedAsync(TicketChangedEventArgs eventArgs)
  {
    await InvokeAsync(RefreshGrid);
  }

  private async Task SetScope(TicketScope scope)
  {
    activeScope = scope;
    await RefreshGrid();
  }

  private async Task RefreshGrid()
  {
    if (grid is not null)
    {
      await grid.ReloadServerData();
    }
  }

  private async Task OnStatusChanged(string? value)
  {
    StatusQuery = value;
    await RefreshGrid();
  }

  private async Task OnSearchInput(string value)
  {
    searchText = value;

    searchDebounceCts?.Cancel();
    searchDebounceCts?.Dispose();
    searchDebounceCts = new CancellationTokenSource();
    var token = searchDebounceCts.Token;

    try
    {
      await Task.Delay(300, token);
      searchTerm = searchText.Trim();
      await RefreshGrid();
    }
    catch (OperationCanceledException)
    {
      // A newer keystroke replaced this pending search.
    }
  }

  private async Task ManagerAssignmentChanged(int ticketId, ChangeEventArgs e)
  {
    await TicketService.AssignTicketAsync(ticketId, e.Value?.ToString());
    await RefreshGrid();
  }

  private async Task AssignToMe(int ticketId, string? agentUserId)
  {
    await TicketService.AssignTicketAsync(ticketId, agentUserId);
    await RefreshGrid();
  }

  private string GetAssigneeName(string? userId) =>
    string.IsNullOrWhiteSpace(userId) ? "-" : agents.FirstOrDefault(a => a.Id == userId)?.DisplayName ?? "Unknown agent";

  private static Color GetStatusColor(TicketStatus status) => status switch
  {
    TicketStatus.Open => Color.Primary,
    TicketStatus.InProgress => Color.Warning,
    TicketStatus.Resolved => Color.Success,
    _ => Color.Default
  };

  private static string GetStatusLabel(TicketStatus status) => status switch
  {
    TicketStatus.InProgress => "In Progress",
    _ => status.ToString()
  };

  private static Color GetPriorityColor(TicketPriority priority) => priority switch
  {
    TicketPriority.Low => Color.Info,
    TicketPriority.Medium => Color.Default,
    TicketPriority.High => Color.Warning,
    TicketPriority.Critical => Color.Error,
    _ => Color.Default
  };

  public async ValueTask DisposeAsync()
  {
    searchDebounceCts?.Cancel();
    searchDebounceCts?.Dispose();
    TicketEvents.TicketChanged -= OnTicketChangedAsync;

    if (pdfModule is not null)
    {
      try
      {
        await pdfModule.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
        // The circuit is already disconnected.
      }
    }
  }
}
