@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Log in - Kestrel Helpdesk</PageTitle>

<div class="auth-page">
    <aside class="auth-story">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 36 36"><path d="M18 3.5 31 11v14L18 32.5 5 25V11Z" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="m12 22 4-10h4l4 10m-10-3h12" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"/></svg></span>
        <p class="eyebrow">SECURE SUPPORT WORKSPACE</p>
        <h1>Good to have you back.</h1>
        <p>Sign in to follow requests, review updates, add useful context and keep work moving toward resolution.</p>
        <div class="auth-story-points">
            <span class="auth-story-point">Find your tickets quickly</span>
            <span class="auth-story-point">Keep comments and files together</span>
            <span class="auth-story-point">See clear status and ownership</span>
        </div>
    </aside>
    <section class="auth-card">
        <p class="eyebrow">WELCOME BACK</p>
        <h2>Sign in to Kestrel</h2>
        <p class="auth-intro">Use your work email and password to continue.</p>
        <StatusMessage Message="@errorMessage" />
            <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label for="Input.Email" class="form-label">Email</label>
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label for="Input.Password" class="form-label">Password</label>
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                        Remember me
                    </label>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                <hr />
                <p>
                    <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">Register as a new user</a>
                </p>
            </EditForm>
    </section>
</div>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        editContext = new EditContext(Input);
    }

    public async Task LoginUser()
    {
        if (!editContext.Validate())
            return;

        var result = await SignInManager.PasswordSignInAsync(
            Input.Email,
            Input.Password,
            Input.RememberMe,
            lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
            return;
        }

        if (result.IsNotAllowed)
        {
            errorMessage = "Error: This account is not allowed to sign in.";
            return;
        }

        if (result.RequiresTwoFactor)
        {
            errorMessage = "Error: Two-factor authentication is not enabled for this application.";
            return;
        }

        errorMessage = "Error: Invalid login attempt.";
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [Display(Name = "Remember me")]
        public bool RememberMe { get; set; }
    }
}
