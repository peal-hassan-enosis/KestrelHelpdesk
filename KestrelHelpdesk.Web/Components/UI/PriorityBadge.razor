@using KestrelHelpdesk.Core.Models

<span class="ticket-priority-badge @GetBadgeClass()" aria-label="Priority: @Priority.ToString()">@Priority.ToString()</span>

@code {
  [Parameter, EditorRequired]
  public TicketPriority Priority { get; set; }

  private string GetBadgeClass() => Priority switch
  {
    TicketPriority.Low => "priority-low",
    TicketPriority.Medium => "priority-medium",
    TicketPriority.High => "priority-high",
    TicketPriority.Critical => "priority-critical",
    _ => "priority-default"
  };
}
