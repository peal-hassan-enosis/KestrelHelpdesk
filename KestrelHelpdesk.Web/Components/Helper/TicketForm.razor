@inject IJSRuntime JS
@inject ILogger<TicketForm> Logger
@inject ITicketAttachmentService TicketAttachmentService
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using KestrelHelpdesk.Core.Authorization
@using KestrelHelpdesk.Core.Models
@using Microsoft.AspNetCore.Components.Forms
@using KestrelHelpdesk.Web.Services

<EditForm Model="TicketModel" OnValidSubmit="HandleValidSubmit" class="ticket-form">
  <DataAnnotationsValidator />
  <ValidationSummary class="alert alert-danger validation-summary-card" />
  <div class="ticket-form-intro"><span class="eyebrow">REQUEST INFORMATION</span><p class="text-muted small mb-0">Fields marked as required must be completed before the request can be saved.</p></div>

  <div class="mb-3">
    <label for="ticket-title" class="form-label fw-bold">Ticket title</label>
    <InputText id="ticket-title" @bind-Value="TicketModel.Title" class="form-control" placeholder="Brief summary of the issue" />
    <ValidationMessage For="@(() => TicketModel.Title)" class="text-danger small" />
  </div>

  <div class="row mb-3">
    <div class="col-md-6">
      <label for="ticket-category" class="form-label fw-bold">Category</label>
      <InputSelect T="TicketCategory?" id="ticket-category" Value="selectedCategory" ValueChanged="OnCategoryChanged" class="form-select @(categoryError is null ? "" : "is-invalid")">
        <option value="">-- Select Category --</option>
        @foreach (var cat in Enum.GetValues<TicketCategory>())
        {
          <option value="@cat">@cat</option>
        }
      </InputSelect>
      @if (!string.IsNullOrWhiteSpace(categoryError))
      {
        <div class="text-danger small">@categoryError</div>
      }
    </div>
    <div class="col-md-6">
      <label for="ticket-priority" class="form-label fw-bold">Priority</label>
      <InputSelect id="ticket-priority" @bind-Value="TicketModel.Priority" class="form-select">
        @foreach (var prio in Enum.GetValues<TicketPriority>())
        {
          <option value="@prio">@prio</option>
        }
      </InputSelect>
      <ValidationMessage For="@(() => TicketModel.Priority)" class="text-danger small" />
    </div>
  </div>

  @if (!IsCreateMode)
  {
    <div class="mb-3">
      <label for="ticket-status" class="form-label fw-bold">Status</label>
      @if (CanEditStatus)
      {
        <InputSelect id="ticket-status" @bind-Value="TicketModel.Status" class="form-select">
          @foreach (var status in Enum.GetValues<TicketStatus>())
          {
            <option value="@status">@GetStatusLabel(status)</option>
          }
        </InputSelect>
      }
      else
      {
        <input id="ticket-status" class="form-control" value="@GetStatusLabel(TicketModel.Status)" disabled />
      }
    </div>
  }

  <div class="mb-3">
    <label for="ticket-description" class="form-label fw-bold">Description</label>
    <InputTextArea id="ticket-description" @bind-Value="TicketModel.Description" class="form-control" rows="5" placeholder="Detailed explanation of the issue" />
    <ValidationMessage For="@(() => TicketModel.Description)" class="text-danger small" />
  </div>

  <section class="mb-4 attachment-section">
    <div class="ticket-section-heading"><span class="eyebrow">FILES &amp; EVIDENCE</span><h2 class="card-title">Attachments</h2></div>
    <label class="file-upload-panel">
      <span class="file-upload-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7 9m5-5 5 5M5 14v5h14v-5"/></svg></span>
      <span class="file-upload-copy">
        <strong>Select supporting files</strong>
        <small>PDF, images, Office files, CSV, text or ZIP · Up to @TicketAttachmentPolicy.MaxFilesPerTicket files, @FormatFileSize(TicketAttachmentPolicy.MaxFileSize) each</small>
        <small class="file-upload-image-note">Images with a longest side over @TicketAttachmentPolicy.MaxImageLongestSide px are automatically resized proportionally. Animated images aren't supported.</small>
      </span>
      <InputFile OnChange="HandleFilesSelected" multiple accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.txt,.csv,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip" />
    </label>

    @if (!string.IsNullOrWhiteSpace(attachmentError))
    {
      <div class="alert alert-danger mt-2 mb-2">@attachmentError</div>
    }

    @if (TicketModel.Attachments.Any())
    {
      <div class="mt-3">
        <div class="fw-semibold mb-2">Existing attachments</div>
        @foreach (var attachment in TicketModel.Attachments.Where(a => !attachmentsToDelete.Contains(a.Id)))
        {
          <div class="d-flex align-items-center justify-content-between attachment-row" @key="attachment.Id">
            <span>@attachment.OriginalFileName (@FormatFileSize(attachment.FileSize))</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => MarkAttachmentForDeletion(attachment.Id)">Delete</button>
          </div>
        }
      </div>
    }

    @if (selectedFiles.Count > 0)
    {
      <div class="mt-3">
        <div class="fw-semibold mb-2">New attachments</div>
        @foreach (var file in selectedFiles)
        {
          <div class="attachment-row attachment-row-new" @key="file">
            @file.Name (@FormatFileSize(file.Size))
          </div>
        }
      </div>
    }
  </section>

  <div class="form-actions">
    <a href="/tickets" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">@SubmitButtonText <span aria-hidden="true">→</span></button>
  </div>
</EditForm>

@code {
  [Parameter, EditorRequired] public Ticket TicketModel { get; set; } = null!;
  [Parameter] public bool IsCreateMode { get; set; }
  [Parameter] public bool CanEditStatus { get; set; } = true;
  [Parameter] public string SubmitButtonText { get; set; } = "Save Ticket";
  [Parameter] public EventCallback<TicketFormSubmission> OnValidSubmit { get; set; }

  private IJSObjectReference? module;
  private List<IBrowserFile> selectedFiles = new();
  private HashSet<int> attachmentsToDelete = new();
  private string? attachmentError;
  private TicketCategory? selectedCategory;
  private string? categoryError;

  protected override void OnInitialized()
  {
    selectedCategory = IsCreateMode ? null : TicketModel.Category;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ticket-form.js");
    await module.InvokeVoidAsync("focusElement", "ticket-title");
  }

  private void OnCategoryChanged(TicketCategory? value)
  {
    selectedCategory = value;
    categoryError = null;
  }

  private void HandleFilesSelected(InputFileChangeEventArgs e)
  {
    attachmentError = null;
    selectedFiles = e.GetMultipleFiles(TicketAttachmentService.MaxFilesPerTicket + 1).ToList();

    var finalCount = TicketModel.Attachments.Count - attachmentsToDelete.Count + selectedFiles.Count;
    if (selectedFiles.Count > TicketAttachmentService.MaxFilesPerTicket || finalCount > TicketAttachmentService.MaxFilesPerTicket)
    {
      selectedFiles.Clear();
      attachmentError = $"A ticket can have a maximum of {TicketAttachmentPolicy.MaxFilesPerTicket} attachments.";
      return;
    }

    var oversized = selectedFiles.FirstOrDefault(f => f.Size > TicketAttachmentService.MaxFileSize);
    if (oversized is not null)
    {
      selectedFiles.Clear();
      attachmentError = $"{oversized.Name} exceeds the {TicketAttachmentPolicy.MaxFileSize / (1024 * 1024)} MB file size limit.";
    }
  }

  private void MarkAttachmentForDeletion(int attachmentId)
  {
    attachmentsToDelete.Add(attachmentId);
    attachmentError = null;
  }

  private async Task HandleValidSubmit()
  {
    attachmentError = null;
    categoryError = null;

    if (selectedCategory is null)
    {
      categoryError = "Category is required.";
      return;
    }

    TicketModel.Category = selectedCategory.Value;

    try
    {
      var errors = await TicketAttachmentService.ValidateFilesAsync(
          IsCreateMode ? 0 : TicketModel.Id,
          selectedFiles,
          attachmentsToDelete);

      if (errors.Count > 0)
      {
        attachmentError = string.Join(" ", errors);
        return;
      }

      if (OnValidSubmit.HasDelegate)
      {
        await OnValidSubmit.InvokeAsync(new TicketFormSubmission(
            TicketModel,
            selectedFiles,
            attachmentsToDelete.ToArray()));
      }
    }
    catch (ValidationException ex)
    {
      attachmentError = ex.Message;
    }
    catch (UnauthorizedAccessException)
    {
      attachmentError = "You are not allowed to access this ticket or its attachments.";
    }
    catch (KeyNotFoundException)
    {
      attachmentError = "The ticket or one of its attachments no longer exists. Reload the page and try again.";
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to validate attachments for ticket {TicketId}.", IsCreateMode ? 0 : TicketModel.Id);
      attachmentError = "The attachments could not be validated. Please try again.";
    }
  }

  private static string GetStatusLabel(TicketStatus status) => status switch
  {
    TicketStatus.InProgress => "In Progress",
    _ => status.ToString()
  };

  private static string FormatFileSize(long bytes) => bytes switch
  {
    >= 1024 * 1024 => $"{bytes / 1024d / 1024d:0.##} MB",
    >= 1024 => $"{bytes / 1024d:0.##} KB",
    _ => $"{bytes} B"
  };

  public async ValueTask DisposeAsync()
  {
    if (module is not null)
      await module.DisposeAsync();
  }
}
