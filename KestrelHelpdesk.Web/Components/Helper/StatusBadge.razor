@using KestrelHelpdesk.Core.Models

<span class="ticket-status-badge @GetBadgeClass()" aria-label="Status: @GetStatusLabel()">@GetStatusLabel()</span>

@code {
  [Parameter, EditorRequired]
  public TicketStatus Status { get; set; }

  private string GetBadgeClass() => Status switch
  {
    TicketStatus.Open => "status-open",
    TicketStatus.InProgress => "status-progress",
    TicketStatus.Resolved => "status-resolved",
    _ => "status-default"
  };

  private string GetStatusLabel() => Status switch
  {
    TicketStatus.InProgress => "In Progress",
    _ => Status.ToString()
  };
}
