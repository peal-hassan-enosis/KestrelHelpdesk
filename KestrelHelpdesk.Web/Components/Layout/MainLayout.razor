@inherits LayoutComponentBase
@using KestrelHelpdesk.Core.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <AuthorizeView Roles="Employee,Agent,Manager">
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>

    <main>
        <div class="top-row px-4">
            <a class="brand-link" href="/">Kestrel Helpdesk</a>

            <AuthorizeView>
                <Authorized>
                    <span class="ms-auto me-3">
                        @context.User.Identity?.Name
                        @if (context.User.IsInRole(AppRoles.Manager))
                        {
                            <span class="badge bg-danger ms-2">Manager</span>
                        }
                        else if (context.User.IsInRole(AppRoles.Agent))
                        {
                            <span class="badge bg-info ms-2">Agent</span>
                        }
                        else if (context.User.IsInRole(AppRoles.Employee))
                        {
                            <span class="badge bg-secondary ms-2">Employee</span>
                        }
                    </span>
                    <form action="/Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Log out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-primary btn-sm" href="/Account/Login">Log in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
