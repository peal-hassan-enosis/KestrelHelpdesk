@inject NavigationManager NavigationManager

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
  <nav class="flex-column">
    <div class="nav-item px-3">
      <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
        Home
      </NavLink>
    </div>

    <div class="nav-item px-3">
      <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
        <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span>
        Dashboard
      </NavLink>
    </div>

    <div class="nav-item px-3">
      <NavLink class="nav-link" href="tickets" Match="NavLinkMatch.All">
        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
        Ticket Board
      </NavLink>
    </div>

    <div class="nav-item px-3">
      <NavLink class="nav-link" href="tickets/new" Match="NavLinkMatch.All">
        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>
        New Ticket
      </NavLink>
    </div>
  </nav>
</div>

@code {
  private string? currentUrl;

  protected override void OnInitialized()
  {
    currentUrl = NavigationManager.ToBaseRelativePath(
        NavigationManager.Uri);

    NavigationManager.LocationChanged += OnLocationChanged;
  }

  private void OnLocationChanged(
      object? sender,
      LocationChangedEventArgs e)
  {
    currentUrl = NavigationManager.ToBaseRelativePath(
        e.Location);

    StateHasChanged();
  }

  public void Dispose()
  {
    NavigationManager.LocationChanged -= OnLocationChanged;
  }
}